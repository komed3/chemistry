{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
    "types": [ "vite/client" ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": { "@/*": [ "./*" ] }
  },
  "exclude": [ "dist" ]
}
